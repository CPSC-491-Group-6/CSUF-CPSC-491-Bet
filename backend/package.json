{
  "name": "bet-backend",
  "version": "1.0.0",
  "description": "Backend REST API for the Bet project",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:reset": "node scripts/resetDatabase.js",
    "db:reset:seed": "npm run db:reset && npm run db:seed",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:auth": "node --test tests/auth/*.test.js tests/services/authService.test.js tests/services/passwordService.test.js tests/repositories/userRepository.test.js tests/stores/sqliteSessionStore.test.js",
    "test:health": "node --test tests/health/health.test.js",
    "demo:auth": "sh scripts/auth-demo.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
